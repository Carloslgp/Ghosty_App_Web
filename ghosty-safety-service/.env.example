# safety-service: copie para .env (cp .env.example .env). O .env nunca vai para o Git.
# Todas as variáveis são validadas ao iniciar; se faltar alguma, o serviço para com a lista do que falta.

PORT=3002
# fatal, error, warn, info, debug, trace ou silent.
LOG_LEVEL=info

# ---------- Banco ----------
# sqlite na máquina local (esquema criado sozinho) ou mssql no Azure SQL (migrações na subida).
DB_PROVIDER=sqlite
SQLITE_PATH=./data/safety.sqlite
# Só com DB_PROVIDER=mssql (na Azure, a senha vem do Key Vault):
MSSQL_HOST=
MSSQL_PORT=1433
MSSQL_DATABASE=safety
MSSQL_USER=app_safety
MSSQL_PASSWORD=
# Pool mínimo 0 e conexões ociosas fechadas em 30 s: o banco serverless consegue pausar.
DB_POOL_MIN=0
DB_POOL_IDLE_MS=30000

# ---------- Segredos ----------
# Chave compartilhada com o BFF e a Function (cabeçalho X-Internal-Key).
INTERNAL_API_KEY=dev-internal-key
# 32 bytes em Base64 para a cifra AES-256-GCM dos campos sensíveis. Este valor é SÓ para a máquina
# local (é recusado com NODE_ENV=production). Para gerar outro: openssl rand -base64 32
DATA_ENCRYPTION_KEY=Y2hhdmUtbG9jYWwtZGUtZGVzZW52b2x2aW1lbnRvISE=

# ---------- Filas (Azurite na máquina local) ----------
# false: o outbox guarda os eventos e a fila alert-dispatches não é lida (útil sem o Azurite).
MESSAGING_ENABLED=true
QUEUE_CONNECTION_STRING=UseDevelopmentStorage=true
QUEUE_HELP_REQUESTS=help-requests
QUEUE_CHECKIN_DEADLINES=check-in-deadlines
QUEUE_ALERT_DISPATCHES=alert-dispatches

# ---------- Regras ----------
# 5 erros no código secreto bloqueiam por 15 minutos.
CODE_MAX_ATTEMPTS=5
CODE_LOCK_MINUTES=15
# Base do link do convite (a página /c/:token do front) e validade para a resposta.
INVITE_BASE_URL=http://localhost:5173/c
INVITE_TTL_HOURS=72
# Nome do bot sem @. Serve só para montar o link t.me/<bot>?start=<token>.
TELEGRAM_BOT_USERNAME=ghosty_dev_bot
