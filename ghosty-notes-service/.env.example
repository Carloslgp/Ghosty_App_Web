# notes-service: copie para .env (cp .env.example .env). O .env nunca vai para o Git.
# Todas as variáveis são validadas ao iniciar; se faltar alguma, o serviço para com a lista do que falta.

# Porta HTTP (Swagger em http://localhost:3001/docs).
PORT=3001

# URI do MongoDB Atlas (mongodb+srv://usuario:senha@cluster.../). Deixe vazia para usar o MongoDB
# em memória (mongodb-memory-server): os dados somem quando o serviço para. Em produção é obrigatória.
MONGODB_URI=

# Banco: notes_dev na máquina local, notes na nuvem.
MONGODB_DB=notes_dev

# Chave compartilhada com o BFF (cabeçalho X-Internal-Key). Mínimo de 8 caracteres.
# Na máquina local, use o mesmo valor em todos os serviços.
INTERNAL_API_KEY=dev-internal-key

# fatal, error, warn, info, debug, trace ou silent.
LOG_LEVEL=info
# Servidor mostrado no Swagger (/docs). Vazio: o localhost do contrato. Na Azure: a URL do Container App.
OPENAPI_SERVER_URL=

# Seed de demonstração (npm run seed:demo / seed:reset): grava 8 notas fictícias da conta demo.
# Exige MONGODB_URI (o MongoDB em memória some ao parar). Use o MESMO UUID do safety-service.
DEMO_ACCOUNT_ID=01a15965-b480-79af-a113-29b2fc82e5ef
