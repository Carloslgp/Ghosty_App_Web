# ghosty-bff: copie para .env (cp .env.example .env). O .env nunca vai para o Git.
# Todas as variáveis são validadas ao iniciar; se faltar alguma, o BFF para com a lista do que falta.

PORT=3000
# fatal, error, warn, info, debug, trace ou silent.
LOG_LEVEL=info
# URL pública do BFF. Também é o "iss" do JWT (na Azure: https://<bff>.<ambiente>.azurecontainerapps.io).
PUBLIC_BASE_URL=http://localhost:3000
# Servidor mostrado no Swagger (/docs). Vazio: o localhost do contrato. Na Azure: a URL do API Gateway.
OPENAPI_SERVER_URL=
# Origens do front, separadas por vírgula. Na nuvem use "none": o API Management responde o CORS, e o
# BFF repetir os cabeçalhos faria o navegador recusar a resposta.
CORS_ORIGINS=http://localhost:5173

# Segredo que o API Management injeta em X-Gateway-Secret. Vazio desliga a verificação (máquina local).
# Obrigatório em produção. Para gerar: openssl rand -hex 32
GATEWAY_SECRET=
# Proxies confiáveis à frente do BFF, para o limite de taxa usar o IP certo (na Azure: 2).
TRUST_PROXY_HOPS=0

# ---------- JWT (RS256) ----------
# Chave privada PKCS#8 em PEM, codificada em Base64. Vazia fora de produção: o BFF gera uma chave
# temporária a cada subida (as sessões caem quando ele reinicia). Para gerar uma fixa:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt-private.pem
#   Linux:   base64 -w0 jwt-private.pem
#   Windows: [Convert]::ToBase64String([IO.File]::ReadAllBytes("jwt-private.pem"))   (PowerShell)
JWT_PRIVATE_KEY_PEM_B64=
JWT_KEY_ID=dev
JWT_AUDIENCE=notes-web
# JWT de acesso; sessão segura (sem uso) e limite absoluto da sessão segura.
ACCESS_TOKEN_TTL=15m
SAFETY_TOKEN_TTL=10m
SAFETY_SESSION_MAX=30m

# ---------- Serviços internos ----------
NOTES_SERVICE_URL=http://localhost:3001
SAFETY_SERVICE_URL=http://localhost:3002
# A mesma chave do notes-service e do safety-service (cabeçalho X-Internal-Key).
INTERNAL_API_KEY=dev-internal-key
# Azure Function (prontidão e prévia da mensagem). A chave fica vazia na máquina local e é
# obrigatória em produção (Function App > Funções > Chaves do aplicativo > default).
FUNCTIONS_BASE_URL=http://localhost:7071
FUNCTIONS_KEY=
# remoteEntry.js do remote "safety", devolvido no desbloqueio.
SAFETY_REMOTE_URL=http://localhost:5175/remoteEntry.js
# Timeout de cada chamada interna, em milissegundos (o painel usa o mesmo limite em cada fonte).
UPSTREAM_TIMEOUT_MS=3000
# Fuso do painel ("lembretes de hoje") e da hora na prévia da mensagem.
APP_TIMEZONE=America/Sao_Paulo

# ---------- Limite de taxa ----------
# Tentativas de login e cadastro por minuto por IP; requisições por minuto por usuário.
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_USER_PER_MINUTE=60
