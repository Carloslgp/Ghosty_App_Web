# Implantação na Azure: copie para azure.env (cp azure.env.example azure.env) e preencha.
# O azure.env nunca vai para o Git. Segredos gerados (chaves internas, JWT, cifra, senhas do SQL) não
# ficam aqui: o deploy.sh cria cada um direto no Key Vault.

# ---------- Obrigatórias ----------
# Assinatura (az account list -o table).
SUBSCRIPTION_ID=
# Região permitida pela policy da assinatura de estudante. Uma só para tudo (ex.: brazilsouth, eastus2).
LOC=brazilsouth
# 4 letras minúsculas aleatórias: os nomes globais (Key Vault, Storage, SQL, Function, APIM) ficam únicos.
SUF=
# E-mail do publisher do API Management (obrigatório na criação).
PUBLISHER_EMAIL=
# Docker Hub: usuário e um access token só de leitura (para o Container Apps baixar as imagens sem o
# limite do pull anônimo). As imagens <usuario>/ghosty-bff, ghosty-notes-service e ghosty-safety-service
# são publicadas pelo workflow docker.yml (git tag v1 && git push origin v1).
DOCKERHUB_USER=
DOCKERHUB_TOKEN=
IMAGE_TAG=v1.1
# URI do MongoDB Atlas (cluster em região Azure), com um usuário readWrite só no banco "notes".
MONGODB_URI=

# ---------- Opcionais ----------
RG=rg-notas
# O Static Web Apps só aceita algumas regiões: westus2, centralus, eastus2, westeurope ou eastasia.
SWA_LOCATION=eastus2
# flex (Flex Consumption) ou consumption (plano B, Windows).
FUNCTIONS_PLAN=flex
# Sufixo da API do BFF no APIM. Vazio é o padrão; use "app" se o portal recusar o sufixo vazio.
APIM_API_PATH=
# Bot do Telegram da NUVEM (outro bot, não o de desenvolvimento). Sem token, nenhum aviso sai pelo
# Telegram (DELIVERY_MODE=simulated) e o webhook não é registrado.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Seed de demonstração (passo seed). O mesmo DEMO_ACCOUNT_ID nos dois serviços.
DEMO_ACCOUNT_ID=01a15965-b480-79af-a113-29b2fc82e5ef
DEMO_PASSWORD=
DEMO_LOCK_CODE=
# Chat do Telegram de quem fará o papel da Ana (opcional; sem ele, a Ana fica no canal web).
DEMO_TELEGRAM_CHAT_ID=

# Teste de fumaça (passo smoke): true pula a espera do prazo do check-in (~1 minuto).
E2E_SKIP_SLOW=false
