<!--
  Política da API web-bff (o BFF), no escopo da API. Named values usados:
    {{shell-origin}}   origem do front (https://<web-main>.azurestaticapps.net)
    {{bff-host}}       FQDN do app-web-api (sem https://)
    {{gateway-secret}} ligado ao Key Vault: prova para o BFF que a chamada veio pelo gateway
  O CORS fica aqui (e não no produto): o preflight não leva a chave de assinatura. O limite de taxa por
  chave fica no produto web-app; o limite por usuário e por IP fica no BFF (o tier Consumption não tem
  rate-limit-by-key).
-->
<policies>
  <inbound>
    <cors allow-credentials="false" terminate-unmatched-request="true">
      <allowed-origins>
        <origin>{{shell-origin}}</origin>
      </allowed-origins>
      <allowed-methods preflight-result-max-age="600">
        <method>GET</method>
        <method>POST</method>
        <method>PUT</method>
        <method>PATCH</method>
        <method>DELETE</method>
        <method>OPTIONS</method>
      </allowed-methods>
      <allowed-headers>
        <header>Authorization</header>
        <header>Content-Type</header>
        <header>X-Safety-Token</header>
        <header>X-Correlation-Id</header>
        <header>Idempotency-Key</header>
        <header>Ocp-Apim-Subscription-Key</header>
      </allowed-headers>
      <expose-headers>
        <header>X-Correlation-Id</header>
        <header>Location</header>
        <header>Retry-After</header>
      </expose-headers>
    </cors>
    <base />
    <!-- Rotas públicas: entrar, cadastro, convite, JWKS, health e Swagger. As demais exigem o JWT. -->
    <choose>
      <when condition="@{
        string path = context.Request.OriginalUrl.Path;
        string prefix = &quot;/&quot; + (context.Api.Path ?? &quot;&quot;).Trim('/');
        if (prefix != &quot;/&quot; &amp;&amp; path.StartsWith(prefix)) { path = path.Substring(prefix.Length); }
        if (path == &quot;&quot;) { path = &quot;/&quot;; }
        return !(path.StartsWith(&quot;/auth/&quot;) || path.StartsWith(&quot;/invitations/&quot;) || path.StartsWith(&quot;/.well-known/&quot;)
          || path == &quot;/health&quot; || path.StartsWith(&quot;/docs&quot;));
      }">
        <validate-jwt header-name="Authorization" require-scheme="Bearer" failed-validation-httpcode="401" failed-validation-error-message="Não autenticado.">
          <openid-config url="https://{{bff-host}}/.well-known/openid-configuration" />
          <audiences>
            <audience>notes-web</audience>
          </audiences>
          <issuers>
            <issuer>https://{{bff-host}}</issuer>
          </issuers>
        </validate-jwt>
      </when>
    </choose>
    <set-header name="X-Gateway-Secret" exists-action="override">
      <value>{{gateway-secret}}</value>
    </set-header>
    <set-header name="X-Correlation-Id" exists-action="skip">
      <value>@(context.RequestId.ToString())</value>
    </set-header>
    <!-- A chave de assinatura é do gateway: não segue para o BFF. -->
    <set-header name="Ocp-Apim-Subscription-Key" exists-action="delete" />
  </inbound>
  <backend>
    <base />
  </backend>
  <outbound>
    <base />
    <set-header name="X-Powered-By" exists-action="delete" />
  </outbound>
  <on-error>
    <base />
  </on-error>
</policies>
