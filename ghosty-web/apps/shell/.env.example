# Variáveis de build do shell (Vite). Copie para .env.local se quiser trocar os padrões.
# BFF direto na máquina local; na nuvem, a URL do API Management.
VITE_API_BASE_URL=http://localhost:3000
# Chave do produto web-app do APIM (pública por natureza). Vazia na máquina local.
VITE_APIM_SUBSCRIPTION_KEY=
# remoteEntry.js do remote notes.
VITE_NOTES_REMOTE_URL=http://localhost:5174/remoteEntry.js
